Package: edpr
Type: Package
Title: Resolution d'EDP Paraboliques par Differences Finies
Version: 0.1.0
Authors@R: 
    person("Vianney Ledoux", "Motsou Tatsi",
           email = "vianneytatsi@gmail.com",
